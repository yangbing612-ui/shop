        "@dcloudio/uni-quickapp-webview": "3.0.0-alpha-3060420220922001",
        "@dcloudio/uni-ui": "1.4.12",
        "@sentry/tracing": "^7.61.0",
        "@sentry/vue": "^7.61.0",
        "@vitejs/plugin-legacy": "^1.7.1",
        "@vitejs/plugin-vue": "^2.2.4",
        "base-64": "^1.0.0",
        "compressorjs": "^1.1.1",
        "crypto-js": "^4.1.1",
