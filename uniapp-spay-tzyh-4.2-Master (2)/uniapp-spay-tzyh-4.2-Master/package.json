        "eslint-define-config": "^1.2.3",
        "eslint-plugin-prettier": "^4.0.0",
        "eslint-plugin-vue": "^8.3.0",
        "http-proxy-middleware": "^2.0.6",
        "husky": "^7.0.4",
        "less": "^4.1.2",
